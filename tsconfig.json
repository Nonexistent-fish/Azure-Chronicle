{
  "compilerOptions": {
    "target": "ES2015",            
    "module": "ES2015",
    "lib": [
      "es2017",                    
      "dom"
    ],
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "strict": false,               
    "noImplicitAny": false,        
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "miniprogram/**/*.ts",
    "typings/index.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}