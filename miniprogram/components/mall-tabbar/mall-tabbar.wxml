<view class="mall-tabbar-wrap">
  <view class="mall-tabbar">
    <view class="tab-item {{currentIdx === 0 ? 'active' : ''}}" data-idx="0" data-path="/pages/mine/market/lotto/lotto" bindtap="switchTab">
      <view class="tab-icon">
        <image class="svg-icon" src="data:image/svg+xml;base64,"></image>
      </view>
      <text class="tab-text">聚宝盆</text>
    </view>

    <view class="tab-item {{currentIdx === 1 ? 'active' : ''}}" data-idx="1" data-path="/pages/mine/market/market" bindtap="switchTab">
      <view class="tab-icon">
        <image class="svg-icon" src="data:image/svg+xml;base64,"></image>
      </view>
      <text class="tab-text">抽奖机</text>
    </view>

    <view class="tab-item {{currentIdx === 2 ? 'active' : ''}}" data-idx="2" data-path="/pages/mine/market/outfit/outfit" bindtap="switchTab">
      <view class="tab-icon">
        <image class="svg-icon" src="data:image/svg+xml;base64,"></image>
      </view>
      <text class="tab-text">外观商城</text>
    </view>
  </view>
</view>

<view class="tabbar-placeholder"></view>

