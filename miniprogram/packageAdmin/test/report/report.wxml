<view class="admin-container">
  <view class="glass-header">
    <view class="header-title">举报处理池</view>
    <view class="tab-box">
      <view class="tab-item {{currentTab === 0 ? 'active' : ''}}" bindtap="switchTab" data-tab="0">待核实<view class="active-line"></view></view>
      <view class="tab-item {{currentTab === 1 ? 'active' : ''}}" bindtap="switchTab" data-tab="1">已结单<view class="active-line"></view></view>
    </view>
  </view>

  <scroll-view class="list-scroll" scroll-y>
    <view class="scroll-inner-wrapper">
      <view wx:if="{{isLoading}}" class="loading-state">
        <view class="spinner"></view><text>加载数据中...</text>
      </view>

      <view wx:elif="{{reportList.length > 0}}" class="bug-list-container">
        <view class="bug-card" wx:for="{{reportList}}" wx:key="_id">
          
          <view class="card-top-bar">
            <view class="user-profile">
              <view class="profile-label">举报人：</view>
              <text class="user-name">{{item.reporterName || '匿名用户'}}</text>
            </view>
            <view class="status-badge st-{{item.safeStatus}}">{{item.statusText}}</view>
          </view>

          <view class="card-header">
            <view class="title-wrap">
              <view class="severity-dot sv-{{item.colorTag}}"></view>
              <text class="bug-title">被举报人：{{item.reportedName || '未知用户'}}</text>
            </view>
          </view>

          <view class="meta-row">
            <text class="meta-tag tag-{{item.colorTag}}">违规理由: {{item.reason}}</text>
            <text class="time-text">{{item.fmtTime}}</text>
          </view>

          <view class="step-box">
            <text class="step-label">举报人补充说明：</text>
            <text class="step-content">{{item.detail || '未填写具体说明，仅提交了快捷分类。'}}</text>
          </view>

          <view class="post-preview-box" bindtap="goToPostDetail" data-postid="{{item.postId}}">
            <view class="preview-header">
              <text class="preview-title">涉嫌违规原贴内容</text>
              <text class="jump-link">点击查看详情 ></text>
            </view>
            <text class="preview-content">{{item.postPreview}}</text>
          </view>

          <view class="reply-box" wx:if="{{item.handleResult}}">
            <view class="reply-header"><text class="reply-label">系统反馈信件内容</text></view>
            <text class="reply-content">{{item.handleResult}}</text>
          </view>

          <view class="card-actions" wx:if="{{item.safeStatus === 0}}">
            <button class="action-btn outline" bindtap="onRejectReport" data-item="{{item}}">驳回 (正常)</button>
            <button class="action-btn primary danger-btn" bindtap="onVerifyReport" data-item="{{item}}">核实 (下架)</button>
          </view>
        </view>
      </view>

      <view wx:else class="empty-state">
        <view class="css-check-circle"></view>
        <text>太棒了！社区氛围非常和谐</text>
      </view>
      
      <view class="bottom-spacer"></view>
    </view>
  </scroll-view>
</view>