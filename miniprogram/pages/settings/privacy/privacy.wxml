<wxs module="privacy">
  var maskName = function(name) { if (!name) return '未填写'; if (name.length <= 2) return name.substring(0, 1) + '*'; return name.substring(0, 1) + '*' + name.substring(name.length - 1); }
  var maskClass = function(cls) { if (!cls) return '未填写'; if (cls.length <= 2) return cls; return cls.substring(0, 2) + '***'; }
  var maskPhone = function(phone) { if (!phone) return ''; if (phone.length <= 4) return phone; var maskedPart = ''; for (var i = 0; i < phone.length - 4; i++) { maskedPart += '*'; } return maskedPart + phone.substring(phone.length - 4); }
  module.exports = { maskName: maskName, maskClass: maskClass, maskPhone: maskPhone };
</wxs>

<view class="container">
  <view class="page-title">身份信息 (已加密)</view>

  <view class="settings-card">
    <view class="item"><text class="label">真实姓名</text><text class="value">{{privacy.maskName(userInfo.realName)}}</text></view>
    <view class="item"><text class="label">班级</text><text class="value">{{privacy.maskClass(userInfo.className)}}</text></view>
  </view>

  <view class="page-title" style="margin-top: 40rpx;">联系方式</view>

  <view class="settings-card">
    <view class="item">
      <text class="label">手机号</text>
      <view class="right-box" bindtap="onEditPhone">
        <text class="input {{!userInfo.phoneNumber ? 'placeholder-text' : ''}}">{{userInfo.phoneNumber ? privacy.maskPhone(userInfo.phoneNumber) : '点击设置'}}</text>
        <text class="edit-icon">✎</text>
      </view>
    </view>

    <view class="item">
      <text class="label">微信号</text>
      <view class="right-box">
        <input class="input" placeholder="点击设置" placeholder-class="placeholder-text" value="{{userInfo.wechatId}}" bindblur="onUpdateWechatId" type="text" />
        <text class="edit-icon">✎</text>
      </view>
    </view>

    <view class="item">
      <text class="label">QQ号</text>
      <view class="right-box">
        <input class="input" placeholder="点击设置" placeholder-class="placeholder-text" value="{{userInfo.qqId}}" bindblur="onUpdateqqId" type="number" />
        <text class="edit-icon">✎</text>
      </view>
    </view>
  </view>
</view>