 
<view class="container">
  <block wx:if="{{posts.length > 0}}">
    <view 
      class="post-card" 
      wx:for="{{posts}}" 
      wx:key="_id" 
      bindtap="goToDetail" 
      data-id="{{item._id}}"
    >
      <view class="status-tag status-{{item.status}}">
        {{statusMap[item.status]}}
      </view>

      <view class="card-body">
        <view class="post-title">{{item.title || '无标题动态'}}</view>
        <view class="post-content">{{item.content}}</view>
      </view>

      <view class="card-footer">
        <text class="time">{{item.timeDisplay}}</text>
        <view class="visibility" wx:if="{{item.status === 1}}">
          <text wx:if="{{item.isPrivate}}">🔒 私密</text>
          <text wx:else>🌍 公开</text>
        </view>
      </view>
    </view>
  </block>

  <view wx:else class="empty-state">
    <view class="empty-icon">📝</view>
    <text>还没发布过内容，快去发一条吧~</text>
  </view>
</view>